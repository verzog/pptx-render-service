# Copy to .env for local development. Do not commit real secrets.

# Bearer token the plugin must send as "Authorization: Bearer <key>".
# Leave empty ONLY for local dev — an empty key disables auth.
RENDER_API_KEY=

# Listen address.
PORT=3000
HOST=0.0.0.0

# Allow JavaScript in the rendered page. Off (0) is safest and is enough for the
# static slide HTML the plugin sends today; set 1 only if you add in-page
# measurement/auto-fit that must run before the screenshot.
RENDER_JS=0

# Guardrails.
RENDER_MAX_SLIDES=200
RENDER_BODY_LIMIT=67108864
